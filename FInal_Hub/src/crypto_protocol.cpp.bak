};


/* ============================================================
 * ML-KEM GLOBAL BUFFERS
 *
 * IMPORTANT:
 * DO NOT MOVE THESE TO LOCAL STACK
 * ============================================================
 */

static uint8_t publicKey[PK_SIZE];

static uint8_t ciphertext[CT_SIZE];

