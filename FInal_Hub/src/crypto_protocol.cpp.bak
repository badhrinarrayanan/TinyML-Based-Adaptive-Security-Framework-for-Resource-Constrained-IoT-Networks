{
    0x20, 0x21, 0x22, 0x23,
    0x24, 0x25, 0x26, 0x27,

    0x28, 0x29, 0x2A, 0x2B,
    0x2C, 0x2D, 0x2E, 0x2F,

    0x30, 0x31, 0x32, 0x33,
    0x34, 0x35, 0x36, 0x37,

