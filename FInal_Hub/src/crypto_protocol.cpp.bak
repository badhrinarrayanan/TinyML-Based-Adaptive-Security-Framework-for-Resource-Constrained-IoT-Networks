/* ============================================================
 * KEM STATE
 * ============================================================
 */

volatile bool pkReceived = false;

volatile bool kemFinished = false;

volatile bool kemSuccess = false;

bool receiveSensorACK(uint8_t expectedMode, uint32_t timeoutMs);
bool receiveKEMACK(uint32_t timeoutMs);


/* ============================================================
