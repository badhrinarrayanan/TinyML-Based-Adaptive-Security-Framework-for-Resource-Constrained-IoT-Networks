/* ============================================================
 * PRINT HEX
 * ============================================================
 */

void printHex(
    const char* label,
    const uint8_t* data,
    size_t length
)
{
    Serial.print(label);

    for(
        size_t i = 0;
        i < length;
        i++
    )
    {
        if(
            data[i] < 0x10
        )
        {
            Serial.print("0");
        }

        Serial.print(
            data[i],
            HEX
        );

        if(
            i != length - 1
        )
        {
            Serial.print(" ");
        }
    }

    Serial.println();
}


/* ============================================================
 * POLICY NAME
 * ============================================================
 */

const char* policyName(
    uint8_t policy
)
{
    switch(policy)
    {
        case SECURITY_NORMAL:
            return "NORMAL";

        case SECURITY_ELEVATED:
            return "ELEVATED";

        case SECURITY_CRITICAL:
            return "CRITICAL";

        default:
            return "UNKNOWN";
    }
}


/* ============================================================
 * SECURITY PROFILE
 * ============================================================
 */

const char* securityProfile(
    uint8_t policy
)
{
    switch(policy)
    {
        case SECURITY_NORMAL:
            return "AES-128-GCM";

        case SECURITY_ELEVATED:
            return "AES-256-GCM";

        case SECURITY_CRITICAL:
            return "ML-KEM-512 + AES-256-GCM";

        default:
            return "UNKNOWN";
    }
}


/* ============================================================
 * WIFI CONNECT
 * ============================================================
 */

void connectWiFi()
{
    Serial.println();

    Serial.println(
        "=============================================="
    );

    Serial.println(
        "S3: CONNECTING TO WIFI"
    );

    Serial.println(
        "=============================================="
    );


    WiFi.mode(
        WIFI_STA
    );


    WiFi.begin(
        WIFI_SSID,
        WIFI_PASSWORD
    );


    while(
        WiFi.status() != WL_CONNECTED
    )
    {
        delay(500);

        Serial.print(".");
    }


    Serial.println();

    Serial.println(
        "S3: WIFI CONNECTED"
    );


    Serial.print(
        "S3 IP   : "
    );

    Serial.println(
        WiFi.localIP()
    );


    Serial.print(
        "NODE IP : "
    );

    Serial.println(
        NODE_IP
    );
}


/* ============================================================
 * UDP START
 *
 * IMPORTANT FIX
 *
 * S3 MUST LISTEN ON 5007.
 *
 * It receives:
 *
 * Node -> S3:
 *   POLICY ACK
 *   ML-KEM PUBLIC KEY
 *
 * ============================================================
 */

bool startUDP()
{
    if(
        udp.begin(
            S3_PORT
        )
    )
    {
        Serial.printf(
            "[S3] UDP listening on %u\n",
            S3_PORT
        );

        return true;
    }


    Serial.println(
        "[S3] UDP START FAILED"
    );


    return false;
}


/* ============================================================
 * SEND POLICY
 * ============================================================
 */

bool sendPolicy(
    uint8_t policy
)
{
    uint8_t packet[4];


    packet[0] = 'A';
    packet[1] = 'I';
    packet[2] = PACKET_POLICY;
    packet[3] = policy;


    Serial.println();

    Serial.println(
        "----------------------------------------------"
    );


    Serial.printf(
        "[S3] POLICY : %s\n",
        policyName(policy)
    );


    Serial.printf(
        "[S3] MODE : %u\n",
        policy
    );


    udp.beginPacket(
        NODE_IP,
        NODE_PORT
    );


    size_t written =
        udp.write(
            packet,
            sizeof(packet)
        );


    int result =
        udp.endPacket();


    if(
        written == sizeof(packet) &&
        result == 1
    )
    {
        Serial.println(
            "[S3] POLICY SENT : PASS"
        );

        return true;
    }


    Serial.println(
        "[S3] POLICY SENT : FAIL"
    );


    return false;
}


/* ============================================================
 * RECEIVE POLICY ACK
 * ============================================================
 */

bool receivePolicyACK(
    uint8_t expectedPolicy,
    uint32_t timeoutMs
)
{
    uint32_t start =
        millis();


    while(
        millis() - start <
        timeoutMs
    )
    {
        int packetSize =
            udp.parsePacket();


        if(
            packetSize <= 0
        )
        {
            delay(5);

            continue;
        }


        if(
            packetSize != 4
        )
        {
            Serial.printf(
                "[S3] Ignoring unexpected packet: %d bytes\n",
                packetSize
            );


            uint8_t discard[1024];


            while(
                udp.available()
            )
            {
                udp.read(
                    discard,
                    sizeof(discard)
                );
            }


            continue;
        }


        uint8_t packet[4];


        int received =
            udp.read(
                packet,
                sizeof(packet)
            );


        if(
            received != 4
        )
        {
            continue;
        }


        if(
            packet[0] == 'A' &&
            packet[1] == 'I' &&
            packet[2] == PACKET_POLICY_ACK
        )
        {
            uint8_t mode =
                packet[3];


            if(
                mode == expectedPolicy
            )
            {
                acknowledgedPolicy =
                    mode;

                policyAckReceived =
                    true;


                Serial.printf(
                    "[S3] POLICY ACK RECEIVED : %s\n",
                    policyName(mode)
                );


                return true;
            }
        }
    }


    Serial.printf(
        "[S3] POLICY ACK TIMEOUT : %s\n",
        policyName(expectedPolicy)
    );


    return false;
}


/* ============================================================
 * SEND POLICY + WAIT FOR ACK
 * ============================================================
 */

bool sendPolicyAndWait(
    uint8_t policy
)
{
    policyAckReceived =
        false;

    acknowledgedPolicy =
        0;


    if(
        !sendPolicy(
            policy
        )
    )
    {
        return false;
    }


    /*
     * Give Node time to process policy.
     */

    delay(100);


    /*
     * Wait for Node confirmation.
     */

    if(
        !receivePolicyACK(
            policy,
            5000
        )
    )
    {
        return false;
    }


    Serial.println(
        "[S3] POLICY SYNCHRONIZATION : PASS"
    );


    return true;
}


/* ============================================================
 * RECEIVE SENSOR ACK
 * ============================================================
 */
bool receiveSensorACK(uint8_t expectedMode, uint32_t timeoutMs)
{
    uint32_t start = millis();
    while (millis() - start < timeoutMs)
    {
        int packetSize = udp.parsePacket();
        if (packetSize <= 0) { delay(5); continue; }
        if (packetSize != 4) { uint8_t d[1024]; while (udp.available()) udp.read(d,sizeof(d)); continue; }
        uint8_t packet[4];
        if (udp.read(packet,4) != 4) continue;
        if (packet[0]=='A' && packet[1]=='I' && packet[2]==PACKET_SENSOR_ACK && packet[3]==expectedMode)
        {
            Serial.printf("[S3] SENSOR ACK RECEIVED : %s\n", policyName(expectedMode));
            Serial.println("[S3] SENSOR AUTHENTICATION : CONFIRMED");
            Serial.println("[S3] SENSOR TRANSACTION : PASS");
            return true;
        }
    }
    Serial.printf("[S3] SENSOR ACK TIMEOUT : %s\n", policyName(expectedMode));
    return false;
}

/* ============================================================
 * RECEIVE KEM ACK
 * ============================================================
 */
bool receiveKEMACK(uint32_t timeoutMs)
{
    uint32_t start = millis();
    while (millis() - start < timeoutMs)
    {
        int packetSize = udp.parsePacket();
        if (packetSize <= 0) { delay(5); continue; }
        if (packetSize != 4) { uint8_t d[1024]; while (udp.available()) udp.read(d,sizeof(d)); continue; }
        uint8_t packet[4];
        if (udp.read(packet,4) != 4) continue;
        if (packet[0]=='A' && packet[1]=='I' && packet[2]==PACKET_KEM_ACK && packet[3]==SECURITY_MLKEM512)
        {
            Serial.println("[S3] KEM ACK RECEIVED : PASS");
            Serial.println("[S3] NODE CONFIRMED ML-KEM VERIFY FAIL = 0");
            return true;
        }
    }
    Serial.println("[S3] KEM ACK TIMEOUT");
    return false;
}

/* ============================================================
 * GENERATE AES-GCM NONCE
 * ============================================================
 */

void generateNonce()
{
    for(
        int i = 0;
        i < GCM_NONCE_SIZE;
        i++
    )
    {
        nonce[i] =
            (uint8_t)(
                esp_random() & 0xFF
            );
    }
}


/* ============================================================
 * AES-GCM ENCRYPT
 * ============================================================
 */

bool aesEncrypt(
    const uint8_t* key,
    size_t keyBits
)
{
    generateNonce();


    mbedtls_gcm_context ctx;


    mbedtls_gcm_init(
        &ctx
    );


    int ret =
        mbedtls_gcm_setkey(
            &ctx,
            MBEDTLS_CIPHER_ID_AES,
            key,
            keyBits
        );


    if(
        ret != 0
    )
    {
        Serial.printf(
            "[S3] GCM SETKEY FAILED : %d\n",
            ret
        );


        mbedtls_gcm_free(
            &ctx
        );


        return false;
    }


    ret =
        mbedtls_gcm_crypt_and_tag(
            &ctx,

            MBEDTLS_GCM_ENCRYPT,

            sizeof(SensorPacket),

            nonce,
            GCM_NONCE_SIZE,

            nullptr,
            0,

            (const unsigned char*)
            &sensorData,

            encryptedSensor,

            GCM_TAG_SIZE,

            tag
        );


    mbedtls_gcm_free(
        &ctx
    );


    if(
        ret != 0
    )
    {
        Serial.printf(
            "[S3] AES-GCM FAILED : %d\n",
            ret
        );

        return false;
    }


    return true;
}


/* ============================================================
 * SEND AES SENSOR PACKET
 *
 * 4 header
 * 12 nonce
 * 12 encrypted SensorPacket
 * 16 tag
 *
 * TOTAL = 44 BYTES
 * ============================================================
 */

bool sendAESPacket(
    uint8_t mode
)
{
    const uint8_t* key;

    size_t keyBits;


    if(
        mode == SECURITY_NORMAL
    )
    {
        key =
            AES128_KEY;

        keyBits =
            128;
    }
    else
    {
        key =
            AES256_KEY;

        keyBits =
            256;
    }


    Serial.println();

    Serial.println(
        "************************************************"
    );


    if(
        mode == SECURITY_NORMAL
    )
    {
        Serial.println(
            "S3: AES-128 AES-GCM"
        );
    }
    else
    {
        Serial.println(
            "S3: AES-256 AES-GCM"
        );
    }


    Serial.println(
        "************************************************"
    );


    Serial.printf(
        "SensorPacket : %u bytes\n",
        (unsigned)sizeof(SensorPacket)
    );


    Serial.printf(
        "Sequence : %lu\n",
        (unsigned long)
        sensorData.sequence
    );


    Serial.printf(
        "Node time : %lu\n",
        (unsigned long)
        sensorData.nodeTime
    );


    Serial.printf(
        "RSSI : %d\n",
        sensorData.rssi
    );


    Serial.printf(
        "MQ2 : %d\n",
        sensorData.mq132
    );


    printHex(
        "AES KEY : ",
        key,
        keyBits / 8
    );


    if(
        !aesEncrypt(
            key,
            keyBits
        )
    )
    {
        Serial.println(
            "AES-GCM ENCRYPTION : FAIL"
        );

        return false;
    }


    Serial.println(
        "AES-GCM ENCRYPTION : PASS"
    );


    printHex(
        "NONCE : ",
        nonce,
        GCM_NONCE_SIZE
    );


    printHex(
        "CIPHERTEXT : ",
        encryptedSensor,
        sizeof(SensorPacket)
    );


    printHex(
        "TAG : ",
        tag,
        GCM_TAG_SIZE
    );


    /*
     * Build packet.
     */

    const int packetSize =
        4 +
        GCM_NONCE_SIZE +
        sizeof(SensorPacket) +
        GCM_TAG_SIZE;


    uint8_t packet[
        4 +
        GCM_NONCE_SIZE +
        sizeof(SensorPacket) +
        GCM_TAG_SIZE
    ];


    packet[0] = 'A';
    packet[1] = 'I';
    packet[2] = PACKET_SENSOR;
    packet[3] = mode;


    memcpy(
        packet + 4,
        nonce,
        GCM_NONCE_SIZE
    );


    memcpy(
        packet +
        4 +
        GCM_NONCE_SIZE,

        encryptedSensor,

        sizeof(SensorPacket)
    );


    memcpy(
        packet +
        4 +
        GCM_NONCE_SIZE +
        sizeof(SensorPacket),

        tag,

        GCM_TAG_SIZE
    );


    udp.beginPacket(
        NODE_IP,
        NODE_PORT
    );


    size_t written =
        udp.write(
            packet,
            packetSize
        );


    int result =
        udp.endPacket();


    if (written != packetSize || result != 1)
    {
        Serial.println("SENSOR PACKET TRANSMISSION : FAIL");
        return false;
    }

    Serial.println("SENSOR PACKET TRANSMISSION : PASS");
    Serial.printf("[S3] Waiting for %s sensor ACK...\n", policyName(mode));
    return receiveSensorACK(mode, 5000);
}


/* ============================================================
 * RECEIVE NODE PUBLIC KEY
 *
 * Packet:
 *
 * 4 header + 800 PK
 *
 * = 804 BYTES
 * ============================================================
 */

bool receivePublicKey(
    uint32_t timeoutMs
)
{
    uint32_t start =
        millis();


    while(
        millis() - start <
        timeoutMs
    )
    {
        int size =
            udp.parsePacket();


        if(
            size <= 0
        )
        {
            delay(5);

            continue;
        }


        Serial.println();

        Serial.printf(
            "[S3] RECEIVED PACKET : %d bytes\n",
            size
        );


        if(
            size !=
            4 + PK_SIZE
        )
        {
            Serial.println(
                "[S3] NOT PUBLIC KEY"
            );


            uint8_t discard[1024];


            while(
                udp.available()
            )
            {
                udp.read(
                    discard,
                    sizeof(discard)
                );
            }


            continue;
        }


        uint8_t packet[
            4 + PK_SIZE
        ];


        int received =
            udp.read(
                packet,
                sizeof(packet)
            );


        if(
            received !=
            sizeof(packet)
        )
        {
            Serial.println(
                "[S3] PUBLIC KEY READ FAILED"
            );

            continue;
        }


        if(
            packet[0] != 'A' ||
            packet[1] != 'I' ||
            packet[2] != PACKET_KEM_KEY ||
            packet[3] != SECURITY_MLKEM512
        )
        {
            Serial.println(
                "[S3] INVALID PUBLIC KEY PACKET"
            );

            continue;
        }


        memcpy(
            publicKey,
            packet + 4,
            PK_SIZE
        );


        Serial.println(
            "[S3] PUBLIC KEY RECEIVED : PASS"
        );


        printHex(
            "PK : ",
            publicKey,
            32
        );


        pkReceived =
            true;


        return true;
    }


    return false;
}


/* ============================================================
 * ML-KEM ENCAPSULATION TASK
 *
 * IMPORTANT:
 *
 * 65536 STACK
 *
 * This avoids the loopTask stack overflow
 * already encountered during Test 5.
 * ============================================================
 */

void kemTask(void* parameter)
{
    Serial.println();
    Serial.println("[S3 KEM TASK] ONLINE");
    Serial.println("[S3 KEM TASK] Stack : 65536 bytes");
    Serial.println();
    Serial.println("************************************************");
    Serial.println("S3: ML-KEM-512 ENCAPSULATION");
    Serial.println("************************************************");

    uint32_t start = micros();
    int ret = PQCLEAN_MLKEM512_CLEAN_crypto_kem_enc(ciphertext, sharedSecret, publicKey);
    uint32_t elapsed = micros() - start;
    Serial.printf("ML-KEM return : %d\n", ret);
    Serial.printf("Encapsulation time : %lu us\n", (unsigned long)elapsed);

    if (ret != 0)
    {
        Serial.println("ML-KEM ENCAPSULATION : FAIL");
        kemSuccess = false;
        kemFinished = true;
        vTaskDelete(NULL);
        return;
    }

    Serial.println("ML-KEM ENCAPSULATION : PASS");
    printHex("SHARED SECRET : ", sharedSecret, SS_SIZE);
    printHex("CIPHERTEXT : ", ciphertext, 32);
    kemSuccess = true;
    kemFinished = true;
    Serial.println("[S3 KEM TASK] FINISHED");
    vTaskDelete(NULL);
}


/* ============================================================
 * START KEM TASK
 * ============================================================
 */

bool startKEMTask()
{
    BaseType_t result =
        xTaskCreate(
            kemTask,
            "S3_KEM_Enc",
            65536,
            nullptr,
            1,
            nullptr
        );


    if(
        result != pdPASS
    )
    {
        Serial.println(
            "[S3] KEM TASK CREATION : FAIL"
        );

        return false;
    }


    Serial.println(
        "[S3] KEM TASK CREATED : PASS"
    );


    return true;
}



/* ============================================================
 * LIVE EDGE-AI FEATURE EXTRACTION
 * ============================================================
 */
#define FEATURE_COUNT 12
#define FEATURE_WINDOW 100

static double mlFeatures[FEATURE_COUNT];
static double mlOutput[2];
static float rssiSamples[FEATURE_WINDOW];
static float iatSamples[FEATURE_WINDOW - 1];
static uint32_t seqSamples[FEATURE_WINDOW];
static uint32_t featureCount = 0;
static uint32_t invalidFeaturePackets = 0;
static uint32_t featureWindowStart = 0;
static uint32_t previousArrival = 0;
static bool haveArrival = false;
static int currentThreatLevel = 0;

static float fmean(const float* a, uint32_t n) {
    if (!n) return 0.0f;
    double s=0; for(uint32_t i=0;i<n;i++) s += a[i];
    return (float)(s/n);
}
static float fvar(const float* a, uint32_t n, float m) {
    if(n<=1) return 0.0f;
    double s=0; for(uint32_t i=0;i<n;i++){ double d=a[i]-m; s+=d*d; }
    return (float)(s/n);
}
static float fminv(const float* a,uint32_t n){ if(!n)return 0; float v=a[0]; for(uint32_t i=1;i<n;i++)if(a[i]<v)v=a[i]; return v; }
static float fmaxv(const float* a,uint32_t n){ if(!n)return 0; float v=a[0]; for(uint32_t i=1;i<n;i++)if(a[i]>v)v=a[i]; return v; }

static void resetMLWindow() {
    featureCount=0; invalidFeaturePackets=0; haveArrival=false; previousArrival=0; featureWindowStart=millis();
}

static void buildMLFeatures() {
    uint32_t n=featureCount;
    uint32_t in=n>1?n-1:0;
    float rm=fmean(rssiSamples,n), rv=fvar(rssiSamples,n,rm);
    float rmin=fminv(rssiSamples,n), rmax=fmaxv(rssiSamples,n);
    float im=fmean(iatSamples,in), iv=fvar(iatSamples,in,im);
    float imin=fminv(iatSamples,in), imax=fmaxv(iatSamples,in);
    uint32_t expected=0;
    if(n>1) expected=seqSamples[n-1]-seqSamples[0]+1; else if(n==1) expected=1;
    float loss=0;
    if(expected>=n && expected>0) loss=(float)(expected-n)/(float)expected;
    float elapsed=(millis()-featureWindowStart)/1000.0f;
    float rate=elapsed>0?(float)n/elapsed:0;
    mlFeatures[0]=rm; mlFeatures[1]=rv; mlFeatures[2]=rmin; mlFeatures[3]=rmax;
    mlFeatures[4]=rmax-rmin; mlFeatures[5]=loss; mlFeatures[6]=im; mlFeatures[7]=iv;
    mlFeatures[8]=imin; mlFeatures[9]=imax; mlFeatures[10]=rate; mlFeatures[11]=(double)invalidFeaturePackets;
}

bool sendPolicyAndWait(uint8_t policy);
bool sendAESPacket(uint8_t mode);
bool receivePublicKey(uint32_t timeoutMs);
bool startKEMTask();
bool receiveKEMACK(uint32_t timeoutMs);
bool aesEncrypt(const uint8_t* key,size_t keyBits);
static bool activateCriticalSecurity();

static void runLiveInference() {
    buildMLFeatures();
    uint32_t start=micros();
    score(mlFeatures, mlOutput);
    uint32_t elapsed=micros()-start;
    double pNormal=mlOutput[0], pAttack=mlOutput[1];
    if(pNormal<0)pNormal=0; if(pNormal>1)pNormal=1; if(pAttack<0)pAttack=0; if(pAttack>1)pAttack=1;
    int level=getThreatLevel((float)pAttack);
    const char* policy=getCryptoProfile((float)pAttack);

    Serial.println();
    Serial.println("================================================");
    Serial.println("        EDGE-AI XGBOOST INFERENCE");
    Serial.println("================================================");
    Serial.printf("P(NORMAL)      : %.9f\n",pNormal);
    Serial.printf("P(ATTACK)      : %.9f\n",pAttack);
    Serial.printf("Inference time : %lu us\n",(unsigned long)elapsed);
    Serial.printf("Threat level   : %d\n",level);
    Serial.printf("Crypto profile : %s\n",policy);
    Serial.printf("Packet loss    : %.6f\n",mlFeatures[5]);
    Serial.printf("Packet rate    : %.6f\n",mlFeatures[10]);

    if(level != currentThreatLevel) {
        Serial.println("******** ADAPTIVE SECURITY JUMP ********");
        Serial.printf("OLD LEVEL : %d\n",currentThreatLevel);
        Serial.printf("NEW LEVEL : %d\n",level);
        Serial.printf("PROFILE   : %s\n",policy);
        if(level==THREAT_CRITICAL) Serial.println("CRITICAL -> ML-KEM-512 + AES-256-GCM");
        Serial.println("****************************************");
        currentThreatLevel=level;

        if(level==THREAT_NORMAL || level==THREAT_ELEVATED) {
            if(sendPolicyAndWait((uint8_t)level)) {
                sendAESPacket((uint8_t)level);
            }
        } else if(level==THREAT_CRITICAL) {
            activateCriticalSecurity();
        }
    }
    Serial.println("================================================");
}

static void processLiveSensor(const uint8_t* data,int len) {
    if(len!=(int)sizeof(SensorPacket)){invalidFeaturePackets++; return;}
    SensorPacket p; memcpy(&p,data,sizeof(p));
    uint32_t now=millis();
    if(featureCount==0) featureWindowStart=now;
    if(haveArrival && featureCount<FEATURE_WINDOW) iatSamples[featureCount-1]=(float)(now-previousArrival);
    if(featureCount>=FEATURE_WINDOW) return;
    rssiSamples[featureCount]=(float)p.rssi;
    seqSamples[featureCount]=p.sequence;
    featureCount++; previousArrival=now; haveArrival=true;
    sensorData=p;
    Serial.printf("[S3] OBS SEQ=%lu RSSI=%d MQ132=%d\n",(unsigned long)p.sequence,p.rssi,p.mq132);
    if(featureCount>=FEATURE_WINDOW) { runLiveInference(); resetMLWindow(); }
}

static bool activateCriticalSecurity() {
    if(!sendPolicyAndWait(SECURITY_CRITICAL)) return false;
    pkReceived=false; kemFinished=false; kemSuccess=false;
    if(!receivePublicKey(10000)) { Serial.println("[S3] PUBLIC KEY TIMEOUT"); return false; }
    if(!startKEMTask()) return false;
    uint32_t waitStart=millis(); while(!kemFinished && millis()-waitStart<15000) delay(20);
    if(!kemSuccess) return false;
    uint8_t packet[4+CT_SIZE];
    packet[0]='A'; packet[1]='I'; packet[2]=PACKET_KEM_CT; packet[3]=SECURITY_MLKEM512;
    memcpy(packet+4,ciphertext,CT_SIZE);
    if(udp.beginPacket(NODE_IP,NODE_PORT)!=1) return false;
    if(udp.write(packet,sizeof(packet))!=sizeof(packet) || udp.endPacket()!=1) return false;
    if(!receiveKEMACK(10000)) return false;
    Serial.println("[S3] ML-KEM HANDSHAKE : PASS");
    if(!aesEncrypt(sharedSecret,256)) return false;
    uint8_t sp[4+GCM_NONCE_SIZE+sizeof(SensorPacket)+GCM_TAG_SIZE];
    sp[0]='A';sp[1]='I';sp[2]=PACKET_SENSOR;sp[3]=SECURITY_CRITICAL;
    memcpy(sp+4,nonce,GCM_NONCE_SIZE);
    memcpy(sp+4+GCM_NONCE_SIZE,encryptedSensor,sizeof(SensorPacket));
    memcpy(sp+4+GCM_NONCE_SIZE+sizeof(SensorPacket),tag,GCM_TAG_SIZE);
    if(udp.beginPacket(NODE_IP,NODE_PORT)!=1) return false;
    if(udp.write(sp,sizeof(sp))!=sizeof(sp) || udp.endPacket()!=1) return false;
    return receiveSensorACK(SECURITY_CRITICAL,5000);
}

/* ============================================================
 * LIVE SETUP
 * ============================================================
 */
void setup()
{
    Serial.begin(115200);
    delay(2000);
    Serial.println();
    Serial.println("################################################");
    Serial.println("       TRI-32 ESP32-S3 EDGE-AI HUB");
    Serial.println("       XGBOOST + ADAPTIVE CRYPTO");
    Serial.println("       BUILD ID: TRI32-FINAL-EDGE-AI");
    Serial.println("################################################");
    connectWiFi();
    if(!startUDP()) { while(true) delay(1000); }
    resetMLWindow();
    Serial.println("[S3] Model : adaptive_threat_xgb.h");
    Serial.println("[S3] NORMAL   -> AES-128-GCM");
    Serial.println("[S3] ELEVATED -> AES-256-GCM");
    Serial.println("[S3] CRITICAL -> ML-KEM-512 + AES-256-GCM");
    Serial.println("[S3] READY");
}

void loop()
{
    int packetSize=udp.parsePacket();
    if(packetSize<=0){ delay(2); return; }
    if(packetSize==(int)sizeof(SensorPacket)) {
        uint8_t b[sizeof(SensorPacket)];
        if(udp.read(b,sizeof(b))==sizeof(b)) processLiveSensor(b,sizeof(b));
        return;
    }
    // ACK/KEM packets are consumed by the explicit handshake functions.
    uint8_t discard[1024];
    while(udp.available()) udp.read(discard,sizeof(discard));
    invalidFeaturePackets++;
}
